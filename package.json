{
  "name": "grantit",
  "private": true,
  "description": "Grantit: grant management for small nonprofits",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "workspaces": [
    "shared",
    "api",
    "web"
  ],
  "scripts": {
    "dev:web": "npm run dev -w web",
    "dev:api": "npm run dev -w api",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "db:migrate": "npm run db:migrate -w api",
    "db:seed": "npm run db:seed -w api",
    "build": "npm run build -w web",
    "check": "npm run check --workspaces --if-present"
  }
}
